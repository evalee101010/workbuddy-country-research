#!/usr/bin/env python3
"""Verify and merge two or more WorkBuddy country data ZIPs."""

import argparse
import json
import sys
from pathlib import Path

from prepare_workspace import ensure_runtime, resolve_workspace


def main():
    parser = argparse.ArgumentParser(description="Merge verified WorkBuddy country data packages.")
    parser.add_argument("packages", nargs="+")
    parser.add_argument("--output-dir", required=True)
    parser.add_argument("--workspace")
    args = parser.parse_args()
    workspace = resolve_workspace(args.workspace)
    output_dir = Path(args.output_dir)
    if not output_dir.is_absolute():
        output_dir = workspace / output_dir
    try:
        runtime, _ = ensure_runtime(workspace)
        sys.path.insert(0, str(runtime))
        from country_runner.manifest import ManifestError
        from country_runner.merge_packages import merge_country_packages

        packages = [Path(value) if Path(value).is_absolute() else workspace / value for value in args.packages]
        result = merge_country_packages(packages, output_dir)
    except (ManifestError, OSError, RuntimeError, ValueError) as error:
        print(f"ERROR: {error}", file=sys.stderr)
        return 2
    print(json.dumps(result, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
