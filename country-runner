#!/bin/sh
set -eu

runner_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
package_root="$runner_root/country_runner"
runner_python=${COUNTRY_RUNNER_PYTHON:-python3}

if [ -n "${PYTHONPATH:-}" ]; then
  export PYTHONPATH="$package_root:$PYTHONPATH"
else
  export PYTHONPATH="$package_root"
fi

exec "$runner_python" -m country_runner "$@"
